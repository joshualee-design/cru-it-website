{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/check-ebook-popup.sh",
            "timeout": 10,
            "statusMessage": "Checking eBook popup feature is intact..."
          }
        ]
      }
    ]
  }
}
